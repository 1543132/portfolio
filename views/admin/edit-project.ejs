<a href="/dashboard">&larr Back</a>
<div class="admin__title">
    <h2>View / Edit Project</h2>

    <form action="/delete-project/<%= data._id %>" method="POST">
        <input type="submit" value="Delete" class="btn--delete btn">
    </form>
</div>

<form action="/edit-project/<%= data._id %>" method="POST">
    <label for="title">Title</label>
    <input id="title" type="text" placeholder="Project Title" name="title" value="<%= data.title %>">

    <label for="body">Content</label>
    <textarea id="body" placeholder="Project Description" cols="50" rows="10" name="body"><%= data.body %></textarea>

    <input type="submit" value="Update" class="btn">
</form>